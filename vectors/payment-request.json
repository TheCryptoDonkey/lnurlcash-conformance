            "127.0.0.1:8899"
          ]
        },
        "to": "npub1qurswpc8qurswpc8qurswpc8qurswpc8qurswpc8qurswpc8qursnvjvl7",
        "memo": "lunch at the café",
        "expires": 1787003600
      },
      "canonical": "{\"amount\":\"21000\",\"currency\":\"sat\",\"expires\":1787003600,\"id\":\"a1b2c3d4e5f60718\",\"memo\":\"lunch at the café\",\"methodDetails\":{\"mints\":[\"mint.example\",\"127.0.0.1:8899\"]},\"to\":\"npub1qurswpc8qurswpc8qurswpc8qurswpc8qurswpc8qurswpc8qursnvjvl7\",\"v\":1}",
      "encoded": "",
      "note": "the memo carries a non-ASCII character on purpose: JCS leaves it alone rather than escaping it, and a canonicaliser that escapes it produces a different string for the same request"
    },
    {
      "name": "keys in a different order encode identically",
      "request": {
        "methodDetails": {
          "mints": [
            "mint.example"
          ]
        },
        "currency": "sat",
        "amount": "500",
        "id": "0123456789abcdef",
        "v": 1
      },
      "canonical": "{\"amount\":\"500\",\"currency\":\"sat\",\"id\":\"0123456789abcdef\",\"methodDetails\":{\"mints\":[\"mint.example\"]},\"v\":1}",
      "encoded": "lnurlcashreq1eyJhbW91bnQiOiI1MDAiLCJjdXJyZW5jeSI6InNhdCIsImlkIjoiMDEyMzQ1Njc4OWFiY2RlZiIsIm1ldGhvZERldGFpbHMiOnsibWludHMiOlsibWludC5leGFtcGxlIl19LCJ2IjoxfQ",
      "note": "the point of canonicalising: the same request built in any order is the same string"
    }
